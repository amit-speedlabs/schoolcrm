# ---- Server ----
PORT=3000
# Postgres / Supabase connection string (Supabase: Project Settings -> Database -> Connection string, "URI")
DATABASE_URL=postgres://postgres:password@localhost:5432/glf_crm
# Set to true for hosted Postgres that requires SSL (e.g. Supabase)
DATABASE_SSL=false
# Set to true when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# ---- First admin (created on first start only if no ADMIN exists) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---- Google Sheets API (service account) ----
# EITHER paste the service-account JSON (raw JSON or base64 of it) ...
GOOGLE_SERVICE_ACCOUNT_JSON=
# ... OR point to the key file on disk
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Sync scheduler ----
SYNC_SCHEDULER=true
# how often the scheduler checks which sources are due (each source has its own frequency)
SYNC_TICK_SECONDS=60

# ---- Demo / tests only ----
# where CSV-backed "fixture" sheets live (demo data + automated tests)
# FIXTURE_DIR=./var/fixtures
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/glf_crm_test
