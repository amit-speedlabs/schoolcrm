# Copy to .env on the server:  cp .env.selfhost.example .env
# Generate the database password with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Your domain (its DNS A record must point at this server) for automatic HTTPS, e.g. crm.example.in
# Leave as :80 to use http://<server-ip> without a domain (then set COOKIE_SECURE=false).
SITE_ADDRESS=:80
COOKIE_SECURE=false

# First admin login, created on first start only if no ADMIN exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

SESSION_TTL_HOURS=12
APP_TIMEZONE=Asia/Kolkata

# Google service-account key JSON (base64 is easiest: base64 -w0 key.json). Can stay empty for now.
GOOGLE_SERVICE_ACCOUNT_JSON=
SYNC_SCHEDULER=true
